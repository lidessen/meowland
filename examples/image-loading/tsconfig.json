{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": ["bun"],
    "lib": ["ES2022", "DOM", "DOM.Iterable", "ESNext.Disposable"],
    "noUncheckedSideEffectImports": true
  },
  "include": [
    "*.ts",
    "*.tsx",
    "scripts/**/*.ts",
    "tests/preview/**/*.ts",
    "tests/preview/**/*.tsx",
    "media-modules.d.ts"
  ],
  "exclude": ["dist", "node_modules", "tests/test-results"]
}
