{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",
    "lib": ["ES2022", "ESNext.AsyncIterable"],
    "types": [],
    "paths": {
      "meowjsx": ["./src/index.ts"],
      "meowjsx/web": ["./web/index.ts"],
      "meowjsx/json": ["./src/json/index.ts"]
    }
  },
  "include": [
    "src/index.ts",
    "src/runtime.ts",
    "src/renderer.ts",
    "src/jsx-runtime.ts",
    "src/jsx-dev-runtime.ts",
    "tests/types/runtime.types.tsx",
    "tests/types/metadata.types.ts",
    "tests/types/json.types.ts",
    "src/json/index.ts"
  ]
}
