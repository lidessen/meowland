{
  "name": "meowpress",
  "version": "0.3.0-alpha.5",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "bun test tests/unit",
    "test:browser": "bun ../../node_modules/@playwright/test/cli.js test --config tests/browser/playwright.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "description": "meowpress library",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lidessen/meowland.git",
    "directory": "packages/meowpress"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    "./build": {
      "types": "./dist/src/build.d.ts",
      "import": "./dist/src/build.js"
    }
  },
  "bin": {
    "meowpress": "./dist/src/cli.js"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@mdx-js/mdx": "^3.1.1",
    "mdast-util-from-markdown": "^2.0.3",
    "meowtail": "^0.4.0-alpha.2",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "meowcss": "^0.3.0-alpha.2",
    "meowjsx": "^0.3.0-alpha.1"
  },
  "devDependencies": {
    "meowjsx": "workspace:*",
    "meowcss": "workspace:*",
    "meowtail": "workspace:*"
  }
