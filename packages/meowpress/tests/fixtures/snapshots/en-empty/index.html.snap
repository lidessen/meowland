<!doctype html>
<html lang="en" data-meowui-page="" data-meowui-scope="" data-meowui-theme-root="meowui" data-meowui-color-scheme="auto"><head><meta charSet="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="description" content="A mixed timeline of long-form posts and fragmentary thoughts."><title>Meowpress site</title><link rel="stylesheet" crossorigin href="./chunk-7m3nygsy.css"><script type="module" crossorigin src="./chunk-HASH.js"></script></head><body data-site="meowpress"><a class="skip-link" href="#main-content">Skip to content</a><div class="site-shell"><div style="width:100%;min-width:0;margin-inline:auto" data-meowui-part="container/root" data-option-container-width="content"><header class="site-header"><a class="site-name" href="/">Meowpress site</a><nav class="site-nav" aria-label="Primary navigation"><a href="/posts/">Posts</a><a href="/thoughts/">Thoughts</a><a href="/skills/">Skills</a><a href="/about/">About</a></nav></header><main id="main-content" tabindex="-1"><div data-meowui-part="page/root"><div style="width:100%;min-width:0;margin-inline:auto" data-meowui-part="container/root" data-option-container-width="content"><div data-meowui-part="page/header"><div class="home-heading"><div class="home-heading-copy"><p data-meowui-part="text/root" data-option-text-variant="eyebrow">Journal</p><header data-meowui-part="page-header/root"><div data-meowui-part="page-header/copy"><h1 data-meowui-part="page-header/title">Meowpress site</h1><p data-meowui-part="page-header/description">A mixed timeline of long-form posts and fragmentary thoughts.</p></div></header></div></div></div><div data-meowui-part="page/toolbar"><div class="feed-filter" data-filter-group="feed" role="group" aria-label="Filter home feed" style="display:flex;flex-direction:row;flex-wrap:wrap;align-items:center;justify-content:flex-start;min-width:0;min-height:0" data-meowui-part="inline/root" data-option-layout-gap="compact" data-option-layout-row-gap="auto" data-option-layout-column-gap="auto"><button data-filter="all" aria-pressed="true" type="button" data-meowui-part="button/root" data-option-button-variant="quiet" data-option-button-size="default">All <span class="filter-count">0</span></button><button data-filter="post" aria-pressed="false" type="button" data-meowui-part="button/root" data-option-button-variant="quiet" data-option-button-size="default">Posts <span class="filter-count">0</span></button><button data-filter="thought" aria-pressed="false" type="button" data-meowui-part="button/root" data-option-button-variant="quiet" data-option-button-size="default">Thoughts <span class="filter-count">0</span></button></div></div><div data-meowui-part="page/content"><div class="feed"><p data-meowui-part="text/root" data-option-text-variant="secondary">No public content yet.</p></div><script>(() => {
  const links = document.querySelectorAll('[data-filter-group="feed"] [data-filter]');
  const items = document.querySelectorAll('.feed [data-kind]');
  const days = document.querySelectorAll('.feed .day');
  links.forEach((link) => link.addEventListener('click', () => {
    const filter = link.dataset.filter;
    links.forEach((button) => button.setAttribute('aria-pressed', String(button === link)));
    items.forEach((item) => { item.hidden = filter !== 'all' && item.dataset.kind !== filter; });
    days.forEach((day) => { day.hidden = !Array.from(day.querySelectorAll('[data-kind]')).some((item) => !item.hidden); });
  }));
})();</script></div></div></div></main><footer class="site-footer"><p data-meowui-part="text/root" data-option-text-variant="caption">© YEAR Meowpress site</p><div style="display:flex;flex-direction:row;flex-wrap:wrap;align-items:center;justify-content:flex-start;min-width:0;min-height:0" data-meowui-part="inline/root" data-option-layout-gap="compact" data-option-layout-row-gap="auto" data-option-layout-column-gap="auto"><a href="/llm.txt">llm.txt</a><a href="/agents.md">agents.md</a></div></footer></div></div></body></html>
