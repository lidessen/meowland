iant="plain" class="day" data-meowui-part="section/root"><header data-meowui-part="section/header"><h2 data-meowui-part="section/title">August 15</h2><p data-meowui-part="section/description">2026 Sat</p></header><div data-meowui-part="section/content"><ul data-meowui-part="entry-list/root"><li data-kind="post" data-meowui-part="entry/root" data-option-entry-size="feature"><p data-meowui-part="entry/eyebrow">Post</p><h3 data-meowui-part="entry/title"><a href="/posts/nested/second/" data-meowui-part="entry/link">Second post</a></h3><p data-meowui-part="entry/description">A short second post.</p><div data-meowui-part="entry/meta"><div data-meowui-part="meta-row/root" data-option-meta-row-align="start" data-option-meta-row-progress-tone="neutral"><span data-meowui-part="meta-row/item"><span data-meowui-part="meta-row/label">2026-08-15</span></span><span aria-hidden="true" data-meowui-part="meta-row/separator">·</span><span data-meowui-part="meta-row/item"><span data-meowui-part="meta-row/label">1 min read</span></span><span aria-hidden="true" data-meowui-part="meta-row/separator">·</span><span data-meowui-part="meta-row/item"><span data-meowui-part="meta-row/label">20 characters</span></span></div></div></li></ul></div></section><img class="feed-image" src="./site-433ymxnw.svg" alt="" loading="lazy" decoding="async"></div><script>(() => {
  const links = document.querySelectorAll('[data-filter-group="feed"] [data-filter]');
  const items = document.querySelectorAll('.feed [data-kind]');
  const days = document.querySelectorAll('.feed .day');
  links.forEach((link) => link.addEventListener('click', () => {
    const filter = link.dataset.filter;
    links.forEach((button) => button.setAttribute('aria-pressed', String(button === link)));
    items.forEach((item) => { item.hidden = filter !== 'all' && item.dataset.kind !== filter; });
    days.forEach((day) => { day.hidden = !Array.from(day.querySelectorAll('[data-kind]')).some((item) => !item.hidden); });
  }));
})();</script></div></div></div></main><footer class="site-footer"><p data-meowui-part="text/root" data-option-text-variant="caption">© YEAR Snapshot site</p><div style="display:flex;flex-direction:row;flex-wrap:wrap;align-items:center;justify-content:flex-start;min-width:0;min-height:0" data-meowui-part="inline/root" data-option-layout-gap="compact" data-option-layout-row-gap="auto" data-option-layout-column-gap="auto"><a href="/llm.txt">llm.txt</a><a href="/agents.md">agents.md</a></div></footer></div></div></body></html>
