<!doctype html>
<html lang="en" data-meowui-page="" data-meowui-scope="" data-meowui-theme-root="meowui" data-meowui-color-scheme="auto"><head><meta charSet="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="description" content="A project fixture."><title>internal · Snapshot site</title><link rel="stylesheet" crossorigin href="../../../chunk-khds3frt.css"><script type="module" crossorigin src="../../../chunk-HASH.js"></script></head><body data-site="meowpress"><a class="skip-link" href="#main-content">Skip to content</a><div class="site-shell"><div style="width:100%;min-width:0;margin-inline:auto" data-meowui-part="container/root" data-option-container-width="wide"><header class="site-header"><a class="site-name" href="/">Snapshot site</a><nav class="site-nav" aria-label="Primary navigation"><a href="/posts/">Posts</a><a href="/thoughts/">Thoughts</a><a href="/skills/" aria-current="page">Skills</a><a href="/about/">About</a></nav></header><main id="main-content" tabindex="-1"><div class="skill-page" data-meowui-part="page/root"><div style="width:100%;min-width:0;margin-inline:auto" data-meowui-part="container/root" data-option-container-width="full"><div data-meowui-part="page/header"><p data-meowui-part="page/eyebrow">Skill</p><header data-meowui-part="page-header/root"><div data-meowui-part="page-header/copy"><h1 data-meowui-part="page-header/title">internal</h1><p data-meowui-part="page-header/description">A project fixture.</p></div></header></div><div data-meowui-part="page/content"><a class="skill-back site-icon-label" href="/skills/"><svg class="meow-icon" data-icon="arrow-left" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg> All Skills</a><header class="skill-browser-head"><span class="skill-command"><span class="skill-scope-badge">Project Skill · Internal</span><code>.agents/skills/internal</code></span><span class="skill-browser-actions"><button type="button" data-copy-command=".agents/skills/internal" data-copy-label="Copy" data-copied-label="Copied">Copy path</button><a class="site-icon-label" href="https://github.com/example/site/tree/main/.agents/skills/internal" target="_blank" rel="noopener noreferrer"><svg class="meow-github-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3.8a8.2 8.2 0 0 0-2.6 16c.4.1.6-.2.6-.4v-1.5c-2.4.5-2.9-1-2.9-1-.4-1-.9-1.3-.9-1.3-.8-.5.1-.5.1-.5.9.1 1.4.9 1.4.9.8 1.4 2.1 1 2.6.8.1-.6.3-1 .6-1.2-1.9-.2-3.9-.9-3.9-4.2 0-.9.3-1.6.9-2.2-.1-.2-.4-1.1.1-2.2 0 0 .7-.2 2.3.9a8 8 0 0 1 4.2 0c1.6-1.1 2.3-.9 2.3-.9.5 1.1.2 2 .1 2.2.6.6.9 1.3.9 2.2 0 3.3-2 4-3.9 4.2.3.3.6.8.6 1.6v2.3c0 .2.2.5.6.4A8.2 8.2 0 0 0 12 3.8Z"></path></svg> GitHub <svg class="meow-icon" data-icon="arrow-up-right" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 7h10v10"></path><path d="M7 17 17 7"></path></svg></a></span></header><div class="skill-stage" data-skill-browser><nav class="skill-view-tabs" aria-label="Skill view mode"><button type="button" data-skill-view="files" aria-pressed="true">File browser</button><button type="button" data-skill-view="relations" aria-pressed="false">Reference graph</button></nav><div class="skill-browser" data-skill-view-panel="files"><nav class="skill-files" aria-label="internal file tree"><span class="skill-files-label">Files</span><ul><li class="file"><button type="button" class="active" data-skill-file="SKILL.md" aria-pressed="true">SKILL.md</button></li></ul></nav><section class="skill-viewer" aria-live="polite"><header class="skill-viewer-bar"><span data-current-file>SKILL.md</span><span>Markdown</span></header><article data-skill-panel="SKILL.md" class="skill-file-panel active" data-meowui-part="prose/root" data-option-prose-measure="reading"><h2>Internal skill</h2>
<p>A project fixture.</p>
</article></section></div><section class="skill-relations" data-skill-view-panel="relations" hidden><div class="skill-reading-summary" aria-label="Reading structure summary"><span><strong>1/1</strong>reachable docs</span><span><strong>0</strong> references</span><span><strong>0</strong> max depth</span><span><strong>0</strong> missing targets</span></div><div class="skill-reading-empty"><strong>No cross-file reading paths</strong><p>Once the Agent enters, it only reads <code>SKILL.md</code>. If other reference material must be read, link it explicitly from the relevant sections with Markdown links.</p></div></section></div><script>(() => {
  document.querySelectorAll('[data-skill-browser]').forEach((browser) => {
    const buttons = Array.from(browser.querySelectorAll('[data-skill-file]'));
    const panels = Array.from(browser.querySelectorAll('[data-skill-panel]'));
    const currentPath = browser.querySelector('[data-current-file]');
    const copyButton = browser.parentElement?.querySelector('[data-copy-command]');
    const viewButtons = Array.from(browser.querySelectorAll('[data-skill-view]'));
    const viewPanels = Array.from(browser.querySelectorAll('[data-skill-view-panel]'));
    const mapNodes = Array.from(browser.querySelectorAll('[data-map-path]'));
    const fileLinks = Array.from(browser.querySelectorAll('[data-skill-panel] a[href]'));
    const mapStatus = browser.querySelector('[data-map-status]');
    const updateMapStatus = (path, detail) => {
      if (!mapStatus) return;
      const code = document.createElement('code');
      code.textContent = path;
      mapStatus.replaceChildren(code, ' ' + (detail || ''));
    };
    const setView = (view) => {
      viewButtons.forEach((button) => {
        const active = button.dataset.skillView === view;
        button.setAttribute('aria-pressed', String(active));
      });
      viewPanels.forEach((panel) => {
        panel.hidden = panel.dataset.skillViewPanel !== view;
      });
    };
    const selectFile = (path, updateHash = true) => {
      if (!path || !panels.some((panel) => panel.dataset.skillPanel === path)) return;
      buttons.forEach((button) => {
        const active = button.dataset.skillFile === path;
        button.classList.toggle('active', active);
        button.setAttribute('aria-pressed', String(active));
      });
      panels.forEach((panel) => {
        const active = panel.dataset.skillPanel === path;
        panel.hidden = !active;
        panel.classList.toggle('active', active);
      });
      mapNodes.forEach((node) => node.classList.toggle('active', node.dataset.mapPath === path));
      const selectedMapNode = mapNodes.find((node) => node.dataset.mapPath === path);
      if (selectedMapNode) updateMapStatus(path, selectedMapNode.dataset.mapDetail);
      if (currentPath) currentPath.textContent = path;
      if (updateHash) history.replaceState(null, '', '#' + encodeURIComponent(path));
    };
    buttons.forEach((button) => button.addEventListener('click', () => {
      selectFile(button.dataset.skillFile);
    }));
    viewButtons.forEach((button) => button.addEventListener('click', () => {
      setView(button.dataset.skillView);
    }));
    mapNodes.forEach((node) => node.addEventListener('click', (event) => {
      event.preventDefault();
      mapNodes.forEach((item) => item.classList.toggle('active', item.dataset.mapPath === node.dataset.mapPath));
      updateMapStatus(node.dataset.mapPath, node.dataset.mapDetail);
      if (node.dataset.mapFile) selectFile(node.dataset.mapFile);
    }));
    fileLinks.forEach((link) => link.addEventListener('click', (event) => {
      const href = link.getAttribute('href');
      const source = link.closest('[data-skill-panel]')?.dataset.skillPanel;
      if (!href || !source || href.startsWith('#') || href.startsWith('/')) return;
      let target;
      try {
        const resolved = new URL(href, 'https://skill.local/' + source);
        if (resolved.origin !== 'https://skill.local') return;
        target = decodeURIComponent(resolved.pathname.slice(1));
      } catch {
        return;
      }
      if (!panels.some((panel) => panel.dataset.skillPanel === target)) return;
      event.preventDefault();
      setView('files');
      selectFile(target);
    }));
    const requested = location.hash ? decodeURIComponent(location.hash.slice(1)) : '';
    if (requested) {
      selectFile(requested, false);
      setView('files');
    } else if (window.matchMedia('(max-width: 560px)').matches) {
      setView('relations');
    }
    copyButton?.addEventListener('click', async () => {
      const command = copyButton.dataset.copyCommand;
      if (!command) return;
      await navigator.clipboard.writeText(command);
      copyButton.textContent = copyButton.dataset.copiedLabel;
      window.setTimeout(() => { copyButton.textContent = copyButton.dataset.copyLabel; }, 1400);
    });
  });
})();</script></div></div></div></main><footer class="site-footer"><p data-meowui-part="text/root" data-option-text-variant="caption">© YEAR Snapshot site</p><div style="display:flex;flex-direction:row;flex-wrap:wrap;align-items:center;justify-content:flex-start;min-width:0;min-height:0" data-meowui-part="inline/root" data-option-layout-gap="compact" data-option-layout-row-gap="auto" data-option-layout-column-gap="auto"><a href="/llm.txt">llm.txt</a><a href="/agents.md">agents.md</a></div></footer></div></div></body></html>
