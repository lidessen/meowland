{
  "name": "meowtail",
  "version": "0.4.0-alpha.0",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "test": "bun test tests/unit",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "description": "meowtail library",
  "files": [
    "dist",
    "AGENT-COMPONENTS.md",
    "CHANGELOG.md",
    "COMPONENTS.md",
    "README.md",
    "ASSISTANT.md",
    "JSON.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./components": {
      "types": "./dist/src/components/index.d.ts",
      "import": "./dist/src/components/index.js"
    },
    "./chat": {
      "types": "./dist/src/chat/index.d.ts",
      "import": "./dist/src/chat/index.js"
    },
    "./icons": {
      "types": "./dist/src/icons/index.d.ts",
      "import": "./dist/src/icons/index.js"
    },
    "./icons/lucide": {
      "types": "./dist/src/icons/lucide.d.ts",
      "import": "./dist/src/icons/lucide.js"
    },
    "./registry": {
      "types": "./dist/src/registry.d.ts",
      "import": "./dist/src/registry.js"
    },
    "./theme": {
      "types": "./dist/src/theme/index.d.ts",
      "import": "./dist/src/theme/index.js"
    },
    "./web": {
      "types": "./dist/src/web/index.d.ts",
      "import": "./dist/src/web/index.js"
    },
    "./json": {
      "types": "./dist/src/json/index.d.ts",
      "import": "./dist/src/json/index.js"
    }
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@shikijs/langs": "4.3.1",
    "lucide": "1.59.0",
    "marked": "18.0.12",
    "pele": "1.9.0",
    "shiki": "4.3.1"
  },
  "peerDependencies": {
    "meowjsx": "^0.3.0-alpha.0",
    "meowcss": "^0.3.0-alpha.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "meowbook": "workspace:*",
    "meowcss": "workspace:*",
    "meowjsx": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lidessen/meowland.git",
    "directory": "packages/meowtail"
  }
}
