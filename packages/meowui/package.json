{
  "name": "meowui",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "bun test tests/unit",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "description": "meowui library",
  "files": [
    "dist",
    "README.md",
    "ASSISTANT.md",
    "JSON.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./components": {
      "types": "./dist/src/components/index.d.ts",
      "import": "./dist/src/components/index.js"
    },
    "./chat": {
      "types": "./dist/src/chat/index.d.ts",
      "import": "./dist/src/chat/index.js"
    },
    "./icons": {
      "types": "./dist/src/icons/index.d.ts",
      "import": "./dist/src/icons/index.js"
    },
    "./registry": {
      "types": "./dist/src/registry.d.ts",
      "import": "./dist/src/registry.js"
    },
    "./theme": {
      "types": "./dist/src/theme/index.d.ts",
      "import": "./dist/src/theme/index.js"
    },
    "./json": {
      "types": "./dist/src/json/index.d.ts",
      "import": "./dist/src/json/index.js"
    }
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@shikijs/langs": "4.3.1",
    "shiki": "4.3.1",
    "marked": "18.0.12"
  },
  "peerDependencies": {
    "meowjsx": "^0.1.0",
    "meowcss": "^0.1.0"
  },
  "devDependencies": {
    "meowjsx": "workspace:*",
    "meowcss": "workspace:*",
    "meowbook": "workspace:*"
  }
}
